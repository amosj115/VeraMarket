# Copy this file to .env and fill in real values.
# Never commit .env with real secrets.

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://vera:vera_dev_password@localhost:5432/vera_market?schema=public"
TEST_DATABASE_URL="postgresql://vera:vera_dev_password@localhost:5432/vera_market_test?schema=public"

# --- Auth ---
# Required in every Vercel environment that serves the application. Generate with:
# npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32-byte-secret"
# Vercel is trusted automatically by src/auth.ts. Set this to "true" if deploying
# behind another trusted reverse proxy; do not set it to "false" on Vercel.
AUTH_TRUST_HOST="false"
# Dev: leave AUTH_URL/NEXTAUTH_URL unset and run `npm run dev:https` so Auth.js follows the HTTPS origin.
# Production: set NEXT_PUBLIC_APP_URL to the public HTTPS origin, e.g. https://veramarket.example.
# Set AUTH_URL to that same origin only if Auth.js cannot infer it from Vercel.
# If using legacy NEXTAUTH_URL, it must be a valid origin with no embedded quotes; do not set conflicting AUTH_URL and NEXTAUTH_URL values.
# AUTH_URL="https://veramarket.example"
# Non-Vercel production deployments behind a reverse proxy/CDN must set AUTH_TRUST_HOST="true".

# --- App ---
# Production: must be the https:// origin (also used for Paystack/Persona callbacks) (also used for the HTTP->HTTPS redirect in src/proxy.ts).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Vera Market"
CRON_SECRET="replace-with-a-random-scheduler-secret"

# --- SMS / Phone verification (Twilio) ---
# Leave blank in development. Phone verification will be disabled and clearly
# reported as "not configured" until these are set.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# --- Identity verification (Persona, https://withpersona.com) ---
# All server-side only; never prefix with NEXT_PUBLIC_. Until all three are set, verification
# returns 503 NOT_CONFIGURED and nobody is verified.
# PERSONA_API_KEY: Persona Dashboard > API Keys (use a production key, "persona_production_...", for live).
# PERSONA_INQUIRY_TEMPLATE_ID: Dashboard > Inquiry Templates > your template, id starts with "itmpl_".
# PERSONA_WEBHOOK_SECRET: Dashboard > Webhooks > create endpoint, then copy its secret (starts "wbhsec_").
#   Webhook URL to register (HTTPS only): https://<your-domain>/api/webhooks/persona
#   Subscribe to events: inquiry.completed, inquiry.approved, inquiry.declined, inquiry.failed, inquiry.expired, inquiry.needs-review
PERSONA_API_KEY=""
PERSONA_INQUIRY_TEMPLATE_ID=""
PERSONA_WEBHOOK_SECRET=""
# Legacy generic HTTP face-match provider (only used when Persona is not configured).
FACE_VERIFICATION_API_URL=""
FACE_VERIFICATION_API_KEY=""
# Defaults to enforced when unset. Production must be "true" (or unset).
PROFILE_VERIFICATION_ENFORCED="true"
# --- Payments (Paystack, ZAR) ---
# Leave blank in development. Boost purchases will be disabled and clearly
# reported as "not configured" until these are set.
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_WEBHOOK_SECRET=""

# --- Email (for verification / notifications) ---
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="Vera Market <no-reply@veramarket.example>"

# --- File storage ---
# "local" stores uploads under /public/uploads (development only; blocked in production
# unless ALLOW_LOCAL_STORAGE="true", which must not be set on serverless hosting).
# Production: STORAGE_DRIVER="s3" with any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2, DigitalOcean Spaces, MinIO).
# Objects are written private; S3_PUBLIC_URL is the HTTPS base URL (CDN or public-read domain) that serves the "uploads/" prefix.
# The server reads images back with its own credentials, so only "uploads/*" needs public read access.
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
# Only for non-AWS providers, e.g. https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
# --- Encryption ---
# Used to encrypt sensitive verification data (e.g. ID document references).
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY="replace-with-a-random-32-byte-key"

# --- Optional: native app deep links (only if a Vera Market mobile app exists) ---
# Served at /.well-known/assetlinks.json and /.well-known/apple-app-site-association; 404 when unset.
ANDROID_APP_PACKAGE=
ANDROID_APP_SHA256=
IOS_APP_ID=
